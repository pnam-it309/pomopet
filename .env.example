# Application Configuration
APP_NAME=PomoPet
APP_ENV=development
APP_PORT=8080
APP_HOST=0.0.0.0
NO_BROWSER=false

# MySQL Database Configuration
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=pomopet
DB_CHARSET=utf8mb4
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MINS=30

# JWT Security Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION_HOURS=72

# Pomodoro Rules Configuration
POMO_DEFAULT_FOCUS_MINS=25
POMO_DEFAULT_SHORT_BREAK_MINS=5
POMO_DEFAULT_LONG_BREAK_MINS=15
POMO_DEFAULT_LONG_BREAK_INTERVAL=4
